# ABUTRON FX V9 — environment configuration
# Copy to .env and fill in. NEVER commit real credentials.

# --- Runtime ---
ABUTRON_ENV=demo
ABUTRON_DATA_ROOT=./data
ABUTRON_PORTAL_HOST=0.0.0.0
ABUTRON_PORTAL_PORT=19743
ABUTRON_ENGINE_TICK=30
ABUTRON_HEARTBEAT_STALE=90

# --- Risk policy (fraction of equity; 0.0015 = 0.15% per trade, 0.20 = 20% portfolio)
# Per-account overrides in CRM. CRM-approved account risk is the non-overridable max.
ABUTRON_RISK_CAP_PCT=0.20
ABUTRON_PER_TRADE_PCT=0.0015
ABUTRON_TRAIL_ATR_MULT=2.0

# --- Wine / MT5 terminal (Ubuntu host) ---
ABUTRON_MT5_ROOT=./data/mt5
ABUTRON_WINE_PREFIX=./data/mt5/wineprefix
ABUTRON_MT5_EXE=Terminal64.exe
ABUTRON_MT5_EXPORT=./data/mt5/MQL5/Files
ABUTRON_MANAGER_SOCK=./data/manager.sock

# --- Brokers ---
ABUTRON_DERIV_SERVERS=Deriv-Demo,synthetic-demo-server
ABUTRON_FP_SYMBOL_SUFFIX=.r

# --- Gemma LLM advisory (optional, advisory-only — never on order path) ---
ABUTRON_GEMMA_ENABLED=false
ABUTRON_GEMMA_BASE_URL=http://127.0.0.1:11434/v1
ABUTRON_GEMMA_MODEL=gemma2:9b
ABUTRON_GEMMA_TIMEOUT=20
ABUTRON_GEMMA_MAX_RETRIES=2

# --- Multi-agent debate layer (TradingAgents pattern; advisory-only) ---
# Bull/bear debate + risk debators + research-manager synthesis. When off,
# the engine falls back to the single Gemma advisor.
ABUTRON_DEBATE_ENABLED=false
ABUTRON_DEBATE_ROUNDS=1
ABUTRON_DEBATE_MAX_CALLS=8

# --- Hardened pre-trade RiskGuard (kweinmeister pattern; fail-closed) ---
# When enabled, an independent hard-limit gate runs on every READY candidate
# before it is stored for the single-writer dispatcher. Off by default.
ABUTRON_RISKGUARD_ENABLED=false

# --- Activation / signing secret (change in production) ---
ABUTRON_ACTIVATION_SECRET=change-me-in-production

# --- Data links / brain / runtime rules (see docs/INSTALL_AND_LINK.md) ---
# Defaults point at data/links/ (populated by scripts/link_all.sh).
ABUTRON_MARKET_DATA_DIR=./data/links/market-data
ABUTRON_TRADE_HISTORY_DIR=./data/links/trade-history
ABUTRON_BRAIN_DIR=./data/brains/unified_m5
# Optional: optimized non-neural sniper/trailing rules JSON.
ABUTRON_RUNTIME_RULES=
# Optional: true microstructure evidence (empty = labelled OHLCV proxies).
ABUTRON_TICK_TRADES=
ABUTRON_DEPTH_SNAPSHOTS=

# --- LIVE trading (blueprint C25 / P34; enabled by default) ---
# Aggressive-mode directive: DEMO and LIVE both trade once the broker
# session is CONNECTED. Set to false to reject environment=live connects
# with LIVE_NOT_APPROVED. This matches src/abutron/config.py and README.md.
ABUTRON_LIVE_TRADING_ENABLED=true
