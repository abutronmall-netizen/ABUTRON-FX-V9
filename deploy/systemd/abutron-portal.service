[Unit]
Description=ABUTRON FX V9 Portal + APEX engine runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=abutron
Group=abutron
WorkingDirectory=/opt/abutron-fx-v9
Environment=ABUTRON_DATA_ROOT=/var/lib/abutron-fx-v9/data
Environment=ABUTRON_ENV=demo
Environment=PYTHONPATH=/opt/abutron-fx-v9/src
ExecStart=/opt/abutron-fx-v9/.venv/bin/python -m abutron.main
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/abutron-fx-v9/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
