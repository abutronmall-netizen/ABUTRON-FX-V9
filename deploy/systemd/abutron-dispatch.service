[Unit]
Description=ABUTRON per-account native order dispatcher
After=abutron-portal.service

[Service]
Type=simple
User=abutron
Group=abutron
WorkingDirectory=/opt/abutron-fx-v9
Environment=ABUTRON_DATA_ROOT=/var/lib/abutron-fx-v9/data
ExecStart=/usr/bin/python3 -m abutron.workers.dispatcher_worker
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/abutron-fx-v9/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
