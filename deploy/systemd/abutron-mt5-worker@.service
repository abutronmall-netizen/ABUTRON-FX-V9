[Unit]
Description=ABUTRON MT5 Wine worker for account %i
After=network-online.target abutron-portal.service
Wants=network-online.target

[Service]
Type=simple
User=abutron
Group=abutron
WorkingDirectory=/opt/abutron-fx-v9
Environment=ABUTRON_CONNECTION_ID=%i
Environment=ABUTRON_DATA_ROOT=/var/lib/abutron-fx-v9/data
ExecStart=/usr/bin/python3 -m abutron.workers.mt5_worker
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/abutron-fx-v9/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
