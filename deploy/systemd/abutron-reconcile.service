[Unit]
Description=ABUTRON broker-native reconciliation run

[Service]
Type=oneshot
User=abutron
Group=abutron
WorkingDirectory=/opt/abutron-fx-v9
Environment=ABUTRON_DATA_ROOT=/var/lib/abutron-fx-v9/data
Environment=PYTHONPATH=/opt/abutron-fx-v9/src
ExecStart=/opt/abutron-fx-v9/.venv/bin/python -m abutron.workers.reconcile_worker
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/abutron-fx-v9/data
PrivateTmp=true
