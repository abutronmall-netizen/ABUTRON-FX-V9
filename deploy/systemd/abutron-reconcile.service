[Unit]
Description=ABUTRON broker-native reconciliation run

[Service]
Type=oneshot
User=abutron
Group=abutron
WorkingDirectory=/opt/abutron-fx-v9
Environment=ABUTRON_DATA_ROOT=/var/lib/abutron-fx-v9/data
ExecStart=/usr/bin/python3 -m abutron.workers.reconcile_worker
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/abutron-fx-v9/data
PrivateTmp=true
