[Unit]
Description=ABUTRON FP DEMO V9 Telegram phone coverage-loss notification delivery (NO ORDERS)
After=network-online.target abutron-fp-v9-13of13-watch-ro.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/sbin/abutron-fp-v9-phone-alert-ro.py
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/abutron-fp-v9-phone-alert
MemoryMax=128M
TasksMax=16
TimeoutStartSec=20s
