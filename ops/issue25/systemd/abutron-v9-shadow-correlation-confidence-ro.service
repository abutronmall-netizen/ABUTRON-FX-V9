[Unit]
Description=ABUTRON V9 owner-isolated broker M5 shadow correlation-aware confidence report (NO ORDERS)
After=abutron-v9-prospective-broker-m5-shadow-ro.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -B /usr/local/sbin/abutron-v9-shadow-correlation-confidence-ro
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/abutron-v9-eight-account-learning/validation/statistical-confidence
MemoryMax=512M
TasksMax=15
TimeoutStartSec=60s
StandardOutput=journal
StandardError=journal
