[Unit]
Description=ABUTRON V9 prospective owner-isolated next-M5 broker-native baseline vs candidate shadow (NO ORDERS)
After=abutron-v9-fp-demo-native-inference-ro.service abutron-v9-coherent-m5-inference-ro.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/abutron-v9-brain/.venv-a88f373/bin/python -B /usr/local/sbin/abutron-v9-prospective-broker-m5-shadow-ro
UMask=0077
Environment=ABUTRON_ENV=demo
Environment=ABUTRON_LIVE_TRADING_ENABLED=false
Environment=ABUTRON_GEMMA_ENABLED=false
Environment=ABUTRON_DATA_ROOT=/var/lib/abutron-v9-eight-account-learning/validation/shadow-runtime
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/abutron-v9-eight-account-learning/validation
MemoryMax=2G
TasksMax=25
TimeoutStartSec=120s
StandardOutput=journal
StandardError=journal
